# ==========================================================
# Entrepreneur Mitra (SIH26092) - Environment Configuration
# ==========================================================

# Application
APP_NAME="Entrepreneur Mitra Backend"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="supersecretkey-change-this-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is local SQLite for zero-setup local/demo run
DATABASE_URL="sqlite:///./entrepreneur_mitra.db"
# For production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/entrepreneur_mitra"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# AI & Voice Mock Toggles (Set False if external LLM/TTS/STT API keys are supplied)
MOCK_AI=True
MOCK_VOICE=True
MOCK_OCR=True

# LLM Providers (Optional for live LLM mode)
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3"
GEMINI_API_KEY=""

# Geo & Maps (Optional)
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
